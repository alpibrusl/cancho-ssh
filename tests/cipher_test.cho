edition 7;
import std.test;
import ssh_cipher as cipher;
import ssh_test_support as support;
import ssh_wire as wire;

// The packet and its sealed form were made with Python's `cryptography` (ChaCha20 with a 16-byte nonce that is the
// 64-bit counter and the sequence number, and Poly1305), following OpenSSH's PROTOCOL.chacha20poly1305: key
// 00..3f, sequence number 0x01020304.
fn clear() -> [] &static [byte] {
    return "000000600468656c6c6f2c2063616e63686f2d6f733a2061207061636b65742074686174206973206c6f6e676572207468616e206f6e652043686143686120626c6f636b2c20746f2063726f73732036342062797465732e2e0000000000000000000000";
}

fn sealed() -> [] &static [byte] {
    return "bc79801b92aa79deb77e0a89b70c4a9fc02f771b721734b613c90cbde617388a55324eac40b45361491f9726a7700bef1389b02fe121de2588256f2880231f66aed7284676dfe158bcdab7959cac124a4ce9a22b58eab11bf76ba4b2c600a3c97f50b62d67db362395d19c64badf0e3d57dbad72";
}

fn key_into[&k](key: &!k [byte]) -> [] int {
    var i = 0;
    while i < 64 {
        key[i] = byte_of(i);
        i = i + 1;
    }
    return 0;
}

fn test_seal_matches_reference() -> [] int {
    region r {
        let key = alloc_slice[r](64, byte_of(0));
        let buf = alloc_slice[r](116, byte_of(0));
        key_into(key);
        test.assert_eq(support.unhex(clear(), buf), 100);
        cipher.seal(key, 0x01020304, buf);
        test.assert(support.hex_is(buf, sealed()));
    }
    return 0;
}

fn test_open_matches_reference() -> [] int {
    region r {
        let key = alloc_slice[r](64, byte_of(0));
        let buf = alloc_slice[r](116, byte_of(0));
        key_into(key);
        support.unhex(sealed(), buf);
        test.assert_eq(cipher.open_length(key, 0x01020304, buf[0..4]), 96);
        test.assert_eq(cipher.open(key, 0x01020304, buf), 0);
        test.assert(support.hex_is(buf[4..100], clear()[8..200]));
    }
    return 0;
}

// Every single-bit change of a sealed packet is refused, and so is the right packet under another sequence number.
fn test_open_refuses_any_changed_bit() -> [] int {
    region r {
        let key = alloc_slice[r](64, byte_of(0));
        let buf = alloc_slice[r](116, byte_of(0));
        key_into(key);
        var bit = 0;
        while bit < 116 * 8 {
            support.unhex(sealed(), buf);
            buf[bit >> 3] = byte_of(int_of(buf[bit >> 3]) ^ 1 << (bit & 7));
            test.assert_eq(cipher.open(key, 0x01020304, buf), wire.bad_mac());
            bit = bit + 1;
        }
        support.unhex(sealed(), buf);
        test.assert_eq(cipher.open(key, 0x01020305, buf), wire.bad_mac());
    }
    return 0;
}

// A draw replaces the key, and two draws differ.
fn test_draw_moves_the_key() -> [] int {
    region r {
        let key = alloc_slice[r](32, byte_of(7));
        let a = alloc_slice[r](32, byte_of(0));
        let b = alloc_slice[r](32, byte_of(0));
        cipher.draw(key, a);
        test.assert(int_of(key[0]) != 7 || int_of(key[1]) != 7 || int_of(key[2]) != 7);
        cipher.draw(key, b[0..16]);
        test.assert(!wire.equal(a[0..16], b[0..16]));
    }
    return 0;
}

// AES-256-GCM as OpenSSH uses it, made with Python's `cryptography` (`AESGCM`): key 00..1f, nonce 64..6f, the four
// bytes of length as the additional data. It also holds `cipher.gcm_prepare` to the layout `std.gcm` reads.
fn gcm_clear() -> [] &static [byte] {
    return "00000030056165732d67636d20696e2063616e63686f2c2061207061636b6574206f766572206f6e6520626c6f636b0000000000";
}

fn gcm_sealed() -> [] &static [byte] {
    return "000000304d7abb15548e35f31e0b31c8b904049e2aad2a2aea4c8313c4bac93cdbccd32de6c92fae2932f9689290133ffd42cacfbfa790dbaaf04bc37b7391d21883208f";
}

fn gcm_nonce[&n](nonce: &!n [byte]) -> [] int {
    var i = 0;
    while i < 12 {
        nonce[i] = byte_of(100 + i);
        i = i + 1;
    }
    return 0;
}

fn test_gcm_seal_and_open_match_reference() -> [] int {
    region r {
        let key = alloc_slice[r](64, byte_of(0));
        let ctx = alloc_slice[r](cipher.gcm_context_len(), 0);
        let nonce = alloc_slice[r](12, byte_of(0));
        let buf = alloc_slice[r](68, byte_of(0));
        key_into(key);
        gcm_nonce(nonce);
        cipher.gcm_prepare(key[0..32], ctx);
        support.unhex(gcm_clear(), buf);
        test.assert_eq(cipher.gcm_seal(ctx, nonce, buf), 0);
        test.assert(support.hex_is(buf, gcm_sealed()));
        test.assert_eq(cipher.gcm_open(ctx, nonce, buf), 0);
        test.assert(support.hex_is(buf[0..52], gcm_clear()));
    }
    return 0;
}

// Every single-bit change is refused, the length in the clear included, and so is the next nonce.
fn test_gcm_open_refuses_any_changed_bit() -> [] int {
    region r {
        let key = alloc_slice[r](64, byte_of(0));
        let ctx = alloc_slice[r](cipher.gcm_context_len(), 0);
        let nonce = alloc_slice[r](12, byte_of(0));
        let buf = alloc_slice[r](68, byte_of(0));
        key_into(key);
        gcm_nonce(nonce);
        cipher.gcm_prepare(key[0..32], ctx);
        var bit = 0;
        while bit < 68 * 8 {
            support.unhex(gcm_sealed(), buf);
            buf[bit >> 3] = byte_of(int_of(buf[bit >> 3]) ^ 1 << (bit & 7));
            test.assert_eq(cipher.gcm_open(ctx, nonce, buf), wire.bad_mac());
            bit = bit + 1;
        }
        support.unhex(gcm_sealed(), buf);
        cipher.gcm_next(nonce);
        test.assert_eq(cipher.gcm_open(ctx, nonce, buf), wire.bad_mac());
    }
    return 0;
}

// The counter is the nonce's last eight bytes, big-endian, and carries; the first four never change.
fn test_gcm_next_carries() -> [] int {
    region r {
        let nonce = alloc_slice[r](12, byte_of(255));
        nonce[4] = byte_of(1);
        cipher.gcm_next(nonce);
        test.assert_eq(int_of(nonce[3]), 255);
        test.assert_eq(int_of(nonce[4]), 2);
        test.assert_eq(int_of(nonce[5]), 0);
        test.assert_eq(int_of(nonce[11]), 0);
        cipher.gcm_next(nonce);
        test.assert_eq(int_of(nonce[11]), 1);
        test.assert_eq(int_of(nonce[10]), 0);
    }
    return 0;
}
